# Copy this file to .env and fill in your values
# cp .env.example .env

# Set to "true" to use your own API keys, "false" to use the workshop proxy
USING_OWN_KEYS=true

# --- LLM ---
# For LM Studio running locally on the host machine:
OPENAI_BASE_URL=http://host.docker.internal:1234/v1
OPENAI_API_KEY=lm-studio
# Set OPENAI_MODEL to the model ID shown in LM Studio (check http://localhost:1234/v1/models)
OPENAI_MODEL=<your-model-id>

# --- Tavily web search ---
TAVILY_API_KEY=<your-tavily-api-key>
TAVILY_BASE_URL="https://api.tavily.com/search"

# --- Arize Phoenix tracing ---
# Leave PHOENIX_COLLECTOR_ENDPOINT unset (default) to automatically start a local
# Phoenix server at http://localhost:6006 when running the setup notebook.
# Uncomment and set to send traces to Phoenix Cloud or a self-hosted remote instance instead.
# PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com
# PHOENIX_API_KEY=<your-phoenix-api-key>

# Set a unique project name to avoid conflicts with other users
PHOENIX_PROJECT_NAME=<your-unique-project-name>

### Free working models
# OPENAI_MODEL=liquid/lfm-2.5-1.2b-instruct:free
# OPENAI_MODEL=openai/gpt-oss-20b:free
OPENAI_MODEL=openai/gpt-oss-120b:free
# OPENAI_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
# OPENAI_MODEL=nvidia/nemotron-3-super-120b-a12b:free

